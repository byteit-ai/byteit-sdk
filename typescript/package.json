{
    "name": "@byteit/sdk",
    "version": "2.0.0",
    "private": false,
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./parseJobs": {
            "import": {
                "types": "./dist/esm/api/resources/parseJobs/exports.d.mts",
                "default": "./dist/esm/api/resources/parseJobs/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/parseJobs/exports.d.ts",
                "default": "./dist/cjs/api/resources/parseJobs/exports.js"
            },
            "default": "./dist/cjs/api/resources/parseJobs/exports.js"
        },
        "./extractJobs": {
            "import": {
                "types": "./dist/esm/api/resources/extractJobs/exports.d.mts",
                "default": "./dist/esm/api/resources/extractJobs/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/extractJobs/exports.d.ts",
                "default": "./dist/cjs/api/resources/extractJobs/exports.js"
            },
            "default": "./dist/cjs/api/resources/extractJobs/exports.js"
        },
        "./classificationJobs": {
            "import": {
                "types": "./dist/esm/api/resources/classificationJobs/exports.d.mts",
                "default": "./dist/esm/api/resources/classificationJobs/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/classificationJobs/exports.d.ts",
                "default": "./dist/cjs/api/resources/classificationJobs/exports.js"
            },
            "default": "./dist/cjs/api/resources/classificationJobs/exports.js"
        },
        "./customJobs": {
            "import": {
                "types": "./dist/esm/api/resources/customJobs/exports.d.mts",
                "default": "./dist/esm/api/resources/customJobs/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/customJobs/exports.d.ts",
                "default": "./dist/cjs/api/resources/customJobs/exports.js"
            },
            "default": "./dist/cjs/api/resources/customJobs/exports.js"
        },
        "./jobs": {
            "import": {
                "types": "./dist/esm/api/resources/jobs/exports.d.mts",
                "default": "./dist/esm/api/resources/jobs/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/jobs/exports.d.ts",
                "default": "./dist/cjs/api/resources/jobs/exports.js"
            },
            "default": "./dist/cjs/api/resources/jobs/exports.js"
        },
        "./schemas": {
            "import": {
                "types": "./dist/esm/api/resources/schemas/exports.d.mts",
                "default": "./dist/esm/api/resources/schemas/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/schemas/exports.d.ts",
                "default": "./dist/cjs/api/resources/schemas/exports.js"
            },
            "default": "./dist/cjs/api/resources/schemas/exports.js"
        },
        "./documentClasses": {
            "import": {
                "types": "./dist/esm/api/resources/documentClasses/exports.d.mts",
                "default": "./dist/esm/api/resources/documentClasses/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/documentClasses/exports.d.ts",
                "default": "./dist/cjs/api/resources/documentClasses/exports.js"
            },
            "default": "./dist/cjs/api/resources/documentClasses/exports.js"
        },
        "./apiKeys": {
            "import": {
                "types": "./dist/esm/api/resources/apiKeys/exports.d.mts",
                "default": "./dist/esm/api/resources/apiKeys/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/apiKeys/exports.d.ts",
                "default": "./dist/cjs/api/resources/apiKeys/exports.js"
            },
            "default": "./dist/cjs/api/resources/apiKeys/exports.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "reference.md",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format": "biome format --write --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "format:check": "biome format --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint": "biome lint --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "lint:fix": "biome lint --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check": "biome check --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "check:fix": "biome check --fix --unsafe --skip-parse-errors --no-errors-on-unmatched --max-diagnostics=none",
        "build": "pnpm build:cjs && pnpm build:esm",
        "build:cjs": "tsc --project ./tsconfig.cjs.json",
        "build:esm": "tsc --project ./tsconfig.esm.json && node scripts/rename-to-esm-files.js dist/esm",
        "test": "vitest",
        "test:unit": "vitest --project unit",
        "test:wire": "vitest --project wire"
    },
    "dependencies": {},
    "devDependencies": {
        "webpack": "^5.105.4",
        "ts-loader": "^9.5.4",
        "vitest": "^4.1.1",
        "msw": "2.11.2",
        "@types/node": "^20.0.0",
        "typescript": "~5.9.3",
        "@biomejs/biome": "2.4.10"
    },
    "browser": {
        "fs": false,
        "os": false,
        "path": false,
        "stream": false,
        "crypto": false
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false,
    "author": "ByteIT GmbH",
    "license": "Apache-2.0",
    "homepage": "https://byteit.ai",
    "description": "Official ByteIt SDK: parse, extract, classify and process documents.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/byteit-ai/byteit-sdk.git",
        "directory": "typescript"
    },
    "bugs": "https://github.com/byteit-ai/byteit-sdk/issues",
    "keywords": ["byteit", "document-parsing", "data-extraction", "ocr", "sdk"]
}
